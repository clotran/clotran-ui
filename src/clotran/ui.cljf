(ns clotran.ui
  "Windows to draw in, from the REPL or a program (PLAN.md): a window is a
  number, drawing is a display list -- plain data -- handed to it, and what
  the person does (mouse, keys, typing, resizing, closing) comes back as
  event maps to a function.

    (def w (ui/window {:title \"hello\" :on-event prn}))
    (ui/draw! w [{:op :rect :x 0 :y 0 :w 600 :h 400 :fill \"#0f0f12\"}
                 {:op :polyline :points [[10 10] [300 200]] :width 2 :colour \"#58C4DD\"}
                 {:op :text :x 20 :y 30 :text \"hi\" :size 14 :colour \"white\"}])
    (ui/close! w)

  The native half (native/clotran_ui.c over libui-ng, vendored) is built
  the first time this namespace loads, into clotran's cache, and opened as
  a clotran package. libui-ng runs on the process's first thread, handed
  to it by fortran/main-thread*; a program that ends with a window open
  stays alive until the window closes, as clj does."
  (:require [clojure.edn]
            [clojure.string :as str]
            [clotran.cache :as cache]))

;; ---- building and opening the native half ----------------------------------

(def ^:private root
  ;; this repository: two directories above this file
  (-> (clotran-resource "clotran/ui.cljf") (str/replace "\\" "/") (str/replace #"/src/clotran/ui\.cljf$" "")))

(def ^:private os
  (let [o (str (clotran.host.system/getProperty "os.name"))]
    (cond (str/starts-with? o "Mac") :mac (str/starts-with? o "Windows") :windows :else :linux)))

(defn- meson-sources
  "The sources a vendored meson.build lists: libui-ng's own list, read
  rather than copied, so the vendored tree stays the one truth."
  [dir]
  (mapv #(str root "/native/libui-ng/" %)
        (map second (re-seq #"'((?:common|darwin|unix|windows)/[A-Za-z0-9_]+\.(?:c|m|cpp))'"
                            (clotran-slurp (str root "/native/libui-ng/" dir "/meson.build"))))))

(defn- sh! [argv dir log what]
  (when-not (zero? (clotran-run (vec argv) dir log nil true))
    (throw (ex-info (str "clotran-ui: " what " failed:\n" (clotran-slurp log)) {:log log}))))

(defn- check-vendored!
  "libui-ng's vendored files against their sha256 pins (native/libui-ng.sha256)."
  [out]
  (let [tool (if (= os :mac) ["shasum" "-a" "256" "-c" "--quiet"] ["sha256sum" "-c" "--quiet"])]
    (sh! (conj tool (str root "/native/libui-ng.sha256")) (str root "/native/libui-ng")
          (str out "/sha256.log") "the sha256 check of the vendored libui-ng")))

(defn- build-command [lib]
  (let [inc ["-I" (str root "/native/libui-ng")]
        shim (str root "/native/clotran_ui.c")
        common (meson-sources "common")]
    (case os
      :mac (concat ["clang" "-shared" "-fPIC" "-O1" "-w" "-std=c99" "-mmacosx-version-min=11.0"
                          "-install_name" "@rpath/libclotran_ui.dylib"] inc ["-o" lib] common
                   (meson-sources "darwin") [shim (str root "/native/darwin.m") (str root "/native/metal.m")]
                   ["-framework" "Foundation" "-framework" "AppKit" "-framework" "CoreGraphics" "-framework" "ImageIO"
                    "-framework" "Metal" "-framework" "QuartzCore"])
      :linux (concat ["sh" "-c" (str "cc -shared -fPIC -O1 -w -std=gnu99 " (str/join " " inc) " -o " lib " "
                                     (str/join " " (concat common (meson-sources "unix") [shim]))
                                     " $(pkg-config --cflags --libs gtk+-3.0) -lm -lpthread")])
      ;; MinGW-w64 (MSYS2 UCRT64): C and C++ to objects beside the library,
      ;; the Common Controls 6 manifest as a resource, then one DLL with the
      ;; C++ and thread runtimes linked in, so it needs no MinGW DLL
      :windows (let [dir (str/replace lib #"[/\\][^/\\]*$" "")
                     cc (fn [c f] (str c " -c -O1 -w " (str/join " " inc) " " f " -o "
                                       (str/replace f #"^.*[/\\]([^/\\]+)[/\\]([^/\\]+)\.[a-z]+$" "$1_$2") ".o"))]
                 ["sh" "-c"
                  (str "set -e; cd " dir "; "
                       (str/join "; " (map #(cc "gcc -std=gnu99 -DCLOTRAN_VULKAN" %) (concat common [shim (str root "/native/windows.c") (str root "/native/vulkan.c")]))) "; "
                       (str/join "; " (map #(cc "g++ -std=c++11" %) (conj (meson-sources "windows") (str root "/native/windows_snap.cpp")))) "; "
                       "windres -I " root "/native/libui-ng/windows " root "/native/libui-ng/windows/resources.rc -o resources.o; "
                       "g++ -shared -o " lib " *.o -static -static-libgcc -static-libstdc++ "
                       "-luser32 -lkernel32 -lgdi32 -lcomctl32 -luxtheme -lmsimg32 -lcomdlg32 -ld2d1 -ldwrite "
                       "-lole32 -loleaut32 -loleacc -luuid -lwindowscodecs -lpthread")]))))

(defn source-hash
  "The native sources' identity on this system: what a library built from
  them is cached under, and what a prebuilt one must have been built from.
  Line ends are made LF first, so a checkout with CRLF ones is the same."
  []
  (str/replace
   (str (hash (conj (mapv #(str/replace (clotran-slurp (str root "/native/" %)) "\r\n" "\n")
                          ["clotran_ui.c" "darwin.m" "windows.c" "metal.m" "g3.h" "windows_snap.cpp" "vulkan.c"
                           "shaders/mesh_vert.h" "shaders/tri_frag.h" "shaders/line_frag.h" "libui-ng.sha256"])
                    os)))
   "-" "m"))

(def ^:private platform (str (name os) "-" (clotran.host.system/getProperty "clotran.arch")))

(defn- on-path? [cmd]
  (let [sep (clotran.host.system/getProperty "path.separator")]
    (some (fn [d] (some #(= :file (clotran-file-kind %)) [(str d "/" cmd) (str d "/" cmd ".exe")]))
          (str/split (or (clotran.host.system/getenv "PATH") "") (re-pattern (str "\\" sep))))))

(defn- compiler?
  "Whether this machine can build the native half: Apple's command-line
  tools on macOS (xcode-select -p answers where they are), MinGW-w64's gcc,
  g++ and windres on Windows, a cc on Linux."
  [out]
  (case os
    :mac (zero? (clotran-run ["xcode-select" "-p"] out (str out "/xcode-select.log") nil true))
    :windows (every? on-path? ["gcc" "g++" "windres" "sh"])
    (boolean (on-path? "cc"))))

(defn- sha256
  "A file's sha256, by the system's own tool: shasum on macOS, certutil on
  Windows (in every Windows), sha256sum elsewhere."
  [f out]
  (let [log (str out "/sha256-of.log")]
    (sh! (case os :mac ["shasum" "-a" "256" f] :windows ["certutil" "-hashfile" f "SHA256"] ["sha256sum" f])
         out log "taking a sha256")
    ;; shasum: "hex  file"; certutil: the hex alone on a line, in pairs on old Windows
    (some (fn [l] (let [l (str/lower-case (str/trim l))]
                    (or (re-matches #"[0-9a-f]{64}" (first (str/split l #"\s+")))
                        (re-matches #"[0-9a-f]{64}" (str/replace l #"\s" "")))))
          (str/split-lines (clotran-slurp log)))))

(defn- fetch-prebuilt!
  "The prebuilt library for this platform (native/prebuilt.edn: its URL, its
  sha256, and the sources it was built from), downloaded to lib and checked;
  refused on any mismatch."
  [lib out h]
  (let [p (get (clojure.edn/read-string (clotran-slurp (str root "/native/prebuilt.edn"))) platform)]
    (when-not p
      (throw (ex-info (str "clotran-ui: no C compiler here and no prebuilt library for " platform
                           " -- install one (Windows: MSYS2 UCRT64; macOS: xcode-select --install)") {})))
    (when-not (= h (:source p))
      (throw (ex-info (str "clotran-ui: no C compiler here, and the prebuilt library for " platform
                           " was built from other sources than these (" (:source p) ", these " h ")") {})))
    (binding [*out* *err*] (println "clotran-ui: fetching the prebuilt library for" platform "(no C compiler here, or CLOTRAN_UI_NATIVE=prebuilt)"))
    (sh! ["curl" "-fsSL" "-o" (str lib ".part") (:url p)] out (str out "/fetch.log") (str "fetching " (:url p)))
    (let [got (sha256 (str lib ".part") out)]
      (when-not (= got (:sha256 p))
        (clotran-delete (str lib ".part"))
        (throw (ex-info (str "clotran-ui: the prebuilt library's sha256 is " got ", not the pinned " (:sha256 p) "; refused") {}))))))

(defn- library
  "The native library's path, made first when there is none for these
  sources: built from them when this machine has a C compiler (or
  CLOTRAN_UI_NATIVE=build), else the pinned prebuilt one fetched and
  checked (or CLOTRAN_UI_NATIVE=prebuilt)."
  []
  (let [h (source-hash)
        out (str (str/replace (cache/root) "\\" "/") "/build/c-" (clotran.host.system/getProperty "clotran.arch") "/clotran-ui-" h)
        lib (str out "/libclotran_ui." (case os :mac "dylib" :windows "dll" "so"))
        want (clotran.host.system/getenv "CLOTRAN_UI_NATIVE")]
    (when-not (clotran-file-exists? lib)
      (clotran-mkdirs out)
      (if (or (= want "build") (and (not= want "prebuilt") (compiler? out)))
        (do (check-vendored! out)
            (binding [*out* *err*] (println "clotran-ui: building libui-ng and its shim, once (about 30 s)"))
            (let [cmd (build-command (str lib ".part"))]
              ;; a shell recipe goes in a file: Windows cuts a command line at 32767
              (if (= "sh" (first cmd))
                (do (clotran-spit (str out "/build.sh") (last cmd))
                    (sh! ["sh" (str out "/build.sh")] out (str out "/build.log") "building libui-ng"))
                (sh! cmd out (str out "/build.log") "building libui-ng"))))
        (fetch-prebuilt! lib out h))
      (clotran-rename (str lib ".part") lib))
    lib))

(defonce ^:private native
  (delay (let [{:keys [handle manifest]} (fortran/load-package* (library))]
           {:handle handle
            :routines (into {} (map (juxt :name identity) (:routines manifest)))})))

(defn- call [routine & args]
  (let [{:keys [handle routines]} @native]
    (fortran/call-package* handle (routines routine) (vec args))))

;; ---- the event loop on the main thread --------------------------------------

(defn- ensure-loop!
  "libui-ng's loop running on the main thread: handed to it when it is not
  (it returns when the last window closes, and is handed again for the
  next)."
  []
  (when (zero? (:running (call "running")))
    ;; false when the slot still holds the loop handed earlier, not yet
    ;; started -- or when nothing serves, which start's wait then reports
    (fortran/main-thread* (:handle @native) "clotran_ui_main")
    (let [ok (:ok (call "start" 10000))]
      (when-not (= 1 ok)
        (throw (ex-info (if (zero? ok) "clotran-ui: libui-ng would not start"
                            "clotran-ui: the event loop did not start in 10 s (is the main thread free? clotran-bin started without its program thread cannot have windows)") {}))))))

;; ---- events --------------------------------------------------------------

(defonce ^:private handlers (atom {}))   ; window -> fn of an event
(defonce ^:private pump (atom nil))      ; the future draining events
(defonce ^:private pending (atom {}))    ; window -> events that came before its handler

(def ^:private kinds {1 :move 2 :down 3 :up 4 :key 5 :resize 6 :closed 7 :text 8 :left 9 :scroll})
(def ^:private ext-keys
  {1 :escape 2 :insert 3 :delete 4 :home 5 :end 6 :page-up 7 :page-down 8 :up 9 :down 10 :left 11 :right})

(defn- event-map [{:keys [kind win x y a b]}]
  (let [t (kinds kind)]
    (case t
      (:move :down :up) (cond-> {:type t :window win :x x :y y}
                          (= t :move) (assoc :held b)
                          (not= t :move) (assoc :button a :count b))
      :key (cond-> {:type :key :window win}
             (pos? a) (assoc :char (char a))
             (pos? b) (assoc :key (ext-keys b b)))
      :resize {:type :resize :window win :width x :height y}
      :scroll {:type :scroll :window win :dy y}
      {:type t :window win})))

(defn- call-handler [f e]
  (try (f e)
       (catch :default ex
         (binding [*out* *err*] (println "clotran-ui: the handler of window" (:window e) "threw:" (ex-message ex))))))

(defn- dispatch
  "e to its window's handler; kept for the handler when the window has
  none yet, if it says what state the window is in (:resize, :text) -- a
  window draws, and so reports its size, before the call that made it
  has returned and its handler is set."
  [e]
  (when-let [f (locking handlers
                 (or (get @handlers (:window e))
                     (do (when (#{:resize :text} (:type e)) (swap! pending update (:window e) (fnil conj []) e))
                         nil)))]
    (call-handler f e)))

(defn- drain
  "Events, to their windows' handlers, until no window is open."
  []
  (loop []
    (let [r (call "next-event" 200)]
      (when (pos? (:kind r))
        (let [e (event-map r)]
          (dispatch e)
          (when (= :closed (:type e)) (swap! handlers dissoc (:window e)) (swap! pending dissoc (:window e)))))
      (if (or (pos? (:kind r)) (pos? (:n (call "open-count"))))
        (recur)
        (reset! pump nil)))))

(defn- ensure-pump! []
  (locking pump
    (when-not @pump (reset! pump (future (drain))))))

;; ---- windows -------------------------------------------------------------

(declare on-event!)

(defn window
  "A new window, open and shown; answers its number. Options: :title,
  :width and :height (600 by 400), :entry true for a text field above the
  drawing area (its changes come as {:type :text}, entry-text reads it),
  and :on-event, a function of each event map: {:type :move :x :y :held},
  {:type :down/:up :x :y :button :count}, {:type :key :char or :key},
  {:type :resize :width :height}, {:type :text}, {:type :left},
  {:type :closed}. A handler runs on clotran's event thread."
  [{:keys [title width height entry on-event] :or {title "clotran" width 600 height 400}}]
  (let [id (loop [tries 0]
             (ensure-loop!)
             (let [id (:id (call "window" (str title) (int width) (int height) (if entry 1 0)))]
               ;; -1: the loop stopped (its last window closed) as we asked
               (if (and (neg? id) (< tries 3)) (recur (inc tries)) id)))]
    (when (neg? id) (throw (ex-info "clotran-ui: the event loop would not stay up" {})))
    (when (zero? id) (throw (ex-info "clotran-ui: too many windows (64)" {})))
    (when on-event (on-event! id on-event))
    (ensure-pump!)
    id))

(defn on-event!
  "f the window's event handler from now on; it is handed first the
  events that came before it was set."
  [w f]
  (let [early (locking handlers
                (swap! handlers assoc w f)
                (let [es (get @pending w)] (swap! pending dissoc w) es))]
    (doseq [e early] (call-handler f e)))
  w)

;; ---- the display list ------------------------------------------------------

(def ^:private names
  {"black" "#000000" "silver" "#c0c0c0" "gray" "#808080" "white" "#ffffff" "maroon" "#800000"
   "red" "#ff0000" "purple" "#800080" "fuchsia" "#ff00ff" "green" "#008000" "lime" "#00ff00"
   "olive" "#808000" "yellow" "#ffff00" "navy" "#000080" "blue" "#0000ff" "teal" "#008080" "aqua" "#00ffff"})

(defn rgba
  "A colour -- #rgb, #rrggbb, #rrggbbaa, one of CSS 1's sixteen names, or
  [r g b a] in 0..1 -- as [r g b a], its alpha times opacity."
  ([c] (rgba c 1.0))
  ([c opacity]
   (if (vector? c)
     (update c 3 * opacity)
     (let [h (str/lower-case (get names (str/lower-case c) c))
           h (if (= 4 (count h)) (apply str "#" (mapcat #(vector % %) (subs h 1))) h)
           hex "0123456789abcdef"
           byte #(/ (+ (* 16 (str/index-of hex (subs h % (+ % 1)))) (str/index-of hex (subs h (+ % 1) (+ % 2)))) 255.0)]
       [(byte 1) (byte 3) (byte 5) (* opacity (if (= 9 (count h)) (byte 7) 1.0))]))))

(defn- encode
  "Marks as the native display list: [doubles strings]."
  [marks]
  (let [strs (volatile! [])
        col (fn [m k] (rgba (k m) (:opacity m 1.0)))
        pts (fn [ps] (mapcat (fn [[x y]] [x y]) ps))
        ds (mapcat (fn [{:keys [op] :as m}]
                     (case op
                       :rect (concat [1 (:x m) (:y m) (:w m) (:h m)] (col m :fill))
                       :polyline (concat [2 (count (:points m)) (:width m 1)] (col m :colour) (pts (:points m)))
                       :polygon (concat [3 (count (:points m))] (col m :fill) [(:width m 0)]
                                        (if (:stroke m) (rgba (:stroke m) (:stroke-opacity m 1.0)) [0 0 0 0])
                                        (pts (:points m)))
                       :text (do (vswap! strs conj (str/replace (str (:text m)) "\u001f" " "))
                                 (concat [4 (:x m) (:y m) ({:start 0 :middle 1 :end 2} (:anchor m :start) 0)
                                          (:size m 14) (if (:italic m) 1 0)]
                                         (col m :colour) [(dec (count @strs))]))))
                   marks)
        ds (vec ds)
        a (fortran/make-array "real8" (max 1 (count ds)))]
    (dotimes [i (count ds)] (fortran/aset a i (double (ds i))))
    [a (count ds) (str/join "\u001f" @strs)]))

(defn draw!
  "The window's drawing replaced by marks -- maps with :op one of
    :rect      :x :y :w :h :fill
    :polyline  :points [[x y] ..] :width :colour
    :polygon   :points :fill, and to outline it :width :stroke :stroke-opacity
    :text      :x :y (the baseline's start) :text :size :colour :anchor (:start
               :middle :end) :italic
  each with an :opacity -- in pixels from the area's top left. :layer 1
  draws over layer 0 (the default) and is replaced on its own: a cursor
  over a picture. :font is the family for text. Answers w."
  [w marks & {:keys [layer font] :or {layer 0 font "Georgia"}}]
  (let [[a n s] (encode marks)]
    (call "scene" (int w) (int layer) a (int n) s (str font))
    w))

(defn set-text!
  "The window's label (:label, under its text field), text field (:entry)
  or title (:title) set to s."
  [w which s]
  (call "text" (int w) (int ({:label 0 :entry 1 :title 2} which)) (str s))
  w)

(defn area-size
  "The window's drawing area, [width height] in pixels, as it was last
  drawn: what a picture for it must be made at."
  [w]
  (let [r (call "area-size" (int w))] [(:width r) (:height r)]))

(defn entry-text
  "What the window's text field holds now."
  [w]
  (let [buf (fortran/make-array "int4" 4096)
        n (:n (call "entry-text" (int w) buf))
        bs (byte-array (map #(unchecked-byte (fortran/aget buf %)) (range n)))]
    (clotran-utf8-string bs 0 n)))

(defn close!
  "The window closed, as by its close button."
  [w]
  (call "close" (int w))
  nil)

(defn open-count [] (:n (call "open-count")))

(defn wait
  "Waits until every window is closed (or ms milliseconds); answers how
  many are still open. A program's last line, when it should end with its
  windows -- though a program that just ends stays alive while one is
  open."
  ([] (wait -1))
  ([ms] (:n (call "wait" (int ms)))))

(defn snapshot
  "The window's drawing replayed into an offscreen picture of width by
  height pixels, written to path: PNG on macOS, BMP on Windows (Direct2D
  in software, no display needed). True when written."
  [w width height path]
  (= 1 (:ok (call "snapshot" (int w) (int width) (int height) (str path)))))

(defn inject!
  "An event put in the window's queue as if the person made it, handled
  as theirs are: what a test drives trace and zoom with. e is an event
  map as the handler gets them (:move :down :up :key :resize)."
  [w {:keys [type x y held button count char key width height dy]}]
  (let [k ({:move 1 :down 2 :up 3 :key 4 :resize 5 :closed 6 :text 7 :left 8 :scroll 9} type)
        ext (into {} (map (fn [[a b]] [b a]) ext-keys))]
    (call "inject" (int w) (int k)
          (double (or x width 0)) (double (or y height dy 0))
          (int (case type (:down :up) (or button 1) :key (if char (int char) 0) 0))
          (int (case type :move (or held 0) (:down :up) (or count 1) :key (if key (ext key) 0) 0)))
    w))

(defn capture
  "The window as it is on screen -- frame, widgets, drawing -- read back
  from the window itself and written to path: true when written. macOS:
  PNG, frame and widgets too; Windows: BMP (PrintWindow). A 3D view: the
  frame it shows, read back from the GPU."
  [w path]
  (= 1 (:ok (call "capture" (int w) (str path)))))

;; ---- the 3D view -------------------------------------------------------------

(defn view3d!
  "The window's drawing area made a 3D view, drawn by the GPU -- Metal on
  macOS, Vulkan on Windows and Linux: true when there is one. Dragging
  turns it (half a degree a pixel) and scrolling zooms it, in C, with no
  trip through clotran; the events still come to the window's handler.
  Without one, g3-error says why."
  [w]
  (= 1 (:ok (call "view3d" (int w)))))

(defn g3-error
  "Why there is no 3D view here (no GPU driver, say), or \"\"."
  []
  (let [buf (fortran/make-array "int4" 512)
        n (:n (call "g3-error" buf))]
    (apply str (map #(char (fortran/aget buf %)) (range n)))))

(defn- doubles-array [xs]
  (let [v (vec xs) a (fortran/make-array "real8" (max 1 (count v)))]
    (dotimes [i (count v)] (fortran/aset a i (double (v i))))
    a))

(defn scene3d!
  "The 3D view's picture: {:vertices [[x y z] ..] :colours [colour ..]
  :triangles [[i j k] ..] :lines [[[x y z] [x y z] colour] ..]
  :background colour}, positions in the unit box (x and y -1/2..1/2, z
  as high as the box is), colours as rgba takes them. Triangles are lit
  from the left, front and above, as clotran-plot's surfaces are."
  [w {:keys [vertices colours triangles lines background]}]
  (let [rgb #(subvec (rgba %) 0 3)
        vs (doubles-array (mapcat (fn [p c] (concat p (rgb c))) vertices colours))
        ts (let [t (vec (apply concat triangles)) a (fortran/make-array "int4" (max 1 (count t)))]
             (dotimes [i (count t)] (fortran/aset a i (int (t i))))
             a)
        ls (doubles-array (mapcat (fn [[p q c]] (concat p (rgb c) q (rgb c))) lines))
        [r g b] (rgb (or background "black"))]
    (call "scene3d" (int w) vs (int (count vertices)) ts (int (count triangles))
          ls (int (count lines)) (double r) (double g) (double b))
    w))

(defn camera
  "The 3D view's camera, {:azimuth :elevation :zoom} (degrees; zoom 1 fits
  the box); with a map, set to it first."
  ([w] (let [r (call "camera3d" (int w) 0 0.0 0.0 0.0)]
         {:azimuth (:azimuth r) :elevation (:elevation r) :zoom (:scale r)}))
  ([w {:keys [azimuth elevation zoom] :or {azimuth -35 elevation 28 zoom 1}}]
   (call "camera3d" (int w) 1 (double azimuth) (double elevation) (double zoom))
   (camera w)))

(defn snapshot3d
  "The 3D view drawn by the GPU offscreen at width by height and written
  to path as PNG: true when written."
  [w width height path]
  (= 1 (:ok (call "snapshot3d" (int w) (int width) (int height) (str path)))))
